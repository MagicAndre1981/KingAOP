<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0;net9.0</TargetFrameworks>
    <PackageId>FjordBob.KingAOP</PackageId>
    <Authors>Fjord Bob</Authors>
    <Owners>fjordBob</Owners>
    <PackageTags>aop, aop-aspects, aop-framework, KingAOP</PackageTags>
    <Title>KingAOP</Title>
    <Description>A modern dotnet ready fork of the KingAOP lib.</Description>
    <PackageVersion>2.0.0</PackageVersion>
    <Version>2.0.0</Version>
    <RepositoryUrl>https://github.com/fjordBob/KingAOP</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/fjordBob/KingAOP</PackageProjectUrl>
    <PackageReleaseNotes>A modern dotnet ready fork of the KingAOP lib. Added .net 8 and .net 9 support</PackageReleaseNotes>
    <Product>KingAOP (modern dotnet ready)</Product>
    <Company />
    <PackageLicenseFile>licence.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" Version="2.0.2">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  
  <ItemGroup Condition="$(TargetFramework.Contains('netstandard'))">
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="licence.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
  
</Project>
